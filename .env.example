# ---------------------------------------------------------------------------
# GARGANTUA — configuration
#
# Copy to backend/.env and edit. Every model name and limit the application
# uses is here; nothing is hard-coded elsewhere. Nothing in this file is a
# secret by default, and no value here is ever sent to the frontend.
# ---------------------------------------------------------------------------

# --- Service identity ------------------------------------------------------
ENVIRONMENT=development          # development | colab | production
LOG_LEVEL=INFO

# --- Storage ---------------------------------------------------------------
# SQLite metadata DB, content-addressed document blobs, and one .npz vector
# index per document all live under this directory.
DATA_DIR=./data

# --- Model backend ---------------------------------------------------------
# auto : use Hugging Face models if torch/transformers import, else mock
# hf   : force real models (requires a GPU for reasonable speed)
# mock : force the deterministic stand-in — used by the test suite
#
# NOTE: on the mock backend, relevance_score and grounding are NOT meaningful
# quantities and abstention will not trigger reliably. It exists so tests run
# without a GPU or a multi-gigabyte download. The UI states the backend on
# screen whenever it is mock.
MODEL_BACKEND=auto

# --- Model names -----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=microsoft/Phi-3-mini-128k-instruct
QA_MODEL=deepset/roberta-base-squad2
# Optional cross-encoder. Unset means the reranker falls back to
# embedding-similarity ranking, which still narrows 8 candidates to 4.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

GENERATION_MAX_NEW_TOKENS=500
GENERATION_TEMPERATURE=0.0       # 0 keeps grounded answers reproducible

# --- Retrieval -------------------------------------------------------------
# These three drive the geodesic trace in the UI: 8 rays launch, 4 survive
# reranking, and anything below the relevance floor abstains.
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
MIN_RELEVANCE_SCORE=0.18

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# --- Upload limits ---------------------------------------------------------
MAX_UPLOAD_BYTES=26214400        # 25 MB
MAX_PAGES_PER_DOCUMENT=300
MAX_IMAGE_PIXELS=40000000        # guards decompression-bomb style images
REQUEST_TIMEOUT_SECONDS=120

# --- Translation -----------------------------------------------------------
TRANSLATION_PROVIDER=google      # google | none

# --- CORS ------------------------------------------------------------------
# Only needed when the frontend is served from a different origin than the
# API (i.e. `npm run dev`). In the Colab and Docker setups FastAPI serves the
# built SPA itself, so both are same-origin and this does not apply.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# --- Colab tunnel ----------------------------------------------------------
# Optional. The notebook defaults to a Cloudflare quick tunnel, which needs
# no account. Set this only if you would rather use ngrok.
# NGROK_AUTHTOKEN=
